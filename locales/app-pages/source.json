        "peaksolo.html"
      ]
    },
    "e06df0062d2a": {
      "source": "Mêmes repères visuels que ConvertAir et DocCipher, avec des parcours adaptés à la gestion d'activité.",
      "markup": true,
      "pages": [
        "peaksolo.html"
      ]
    },
    "e584d2e662e8": {
      "source": "Une promesse à vérifier avant la sortie.",
      "markup": true,
      "pages": [
        "peaksolo.html"
      ]
    },
    "85cc3e9d53d5": {
      "source": "La cible est un traitement local des données métier, avec Google Play et RevenueCat pour les achats. La version en préparation contient encore des fonctions à vérifier ou retirer avant de promettre des connexions limitées aux achats.",
